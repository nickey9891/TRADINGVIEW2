# Tradier production token. Never commit a real token.
TRADIER_TOKEN=replace_me
TRADIER_BASE_URL=https://api.tradier.com/v1
TRADIER_STREAM_URL=https://stream.tradier.com/v1/markets/events

# Optional protection for the MCP endpoint. If set, clients must send:
# Authorization: Bearer <MCP_ACCESS_KEY>
MCP_ACCESS_KEY=replace_with_a_long_random_value
